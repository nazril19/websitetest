    },
    {
      id: "arif",
      name: "Arif Setiawan",
      color: palette[6],
      online: true,
      messages: [
        {from:"in",  text:"Bang, laptop kantor bisa dipinjam gak buat besok?", time:"10:20"},
        {from:"out", text:"Bisa, ambil aja di meja aku", time:"10:22", read:true},

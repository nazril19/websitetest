      online: false,
      lastSeen: "terakhir dilihat kemarin",
      messages: [
        {from:"in",  text:"Nak, jangan lupa makan siang ya", time:"Kemarin"},
        {from:"out", text:"Siap bu, sudah kok tadi 😊", time:"Kemarin", read:true}
      ]
    },
    {
      id: "sella",
      name: "Sella Amara",
      color: palette[4],
      online: true,
      messages: [
        {from:"in",  text:"Selamat ya atas launching produknya! 🎉", time:"Sen"},
        {from:"out", text:"Terima kasih Sella!", time:"Sen", read:true}

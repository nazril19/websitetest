        {from:"in",  text:"Siap, ini bagus banget palettenya", time:"11:45"},
        {from:"in",  text:"Kita pakai yang nomor 2 aja gimana?", time:"11:46"}
      ]
    },
    {
      id: "pak-rt",
      name: "Pak RT 05",
      color: palette[9],
      online: false,
      lastSeen: "terakhir dilihat kemarin",
      messages: [
        {from:"in",  text:"Warga yth, kerja bakti hari Minggu jam 7 pagi", time:"Kemarin"},
        {from:"in",  text:"Mohon partisipasinya, terima kasih", time:"Kemarin"}
      ]
    },
    {
      id: "fajar",
      name: "Fajar Ramadhan",
      color: palette[10],
      online: true,
      messages: [
        {from:"in",  text:"Eh jadi nonton bola malam ini?", time:"Sel"},
        {from:"out", text:"Jadi, di tempat biasa jam 8", time:"Sel", read:true},
        {from:"in",  text:"Oke gas, aku bawa cemilan", time:"Sel"}
      ]
    },
    {
      id: "customer-service",
      name: "CS Toko Berkah",
      color: palette[11],
      online: false,
      lastSeen: "terakhir dilihat Minggu",
      messages: [
        {from:"in",  text:"Terima kasih sudah berbelanja di toko kami 🙏", time:"Min"},
        {from:"in",  text:"Pesanan Anda sedang dikemas dan akan segera dikirim", time:"Min"}
      ]
    }
  ];
 
  const autoReplies = [
    "Oke, aku cek dulu ya.",
    "Siap, ditunggu kabarnya!",
    "Hehe iya betul.",
    "Wah baru tahu aku, makasih infonya.",
    "Boleh, nanti kukabari lagi.",
    "Noted 👍"
  ];
 
  let activeId = contacts[0].id;
  let unread = {"tim-proyek": 1, "ibu": 1, "keluarga-besar": 2, "pak-rt": 1, "customer-service": 1};
 
  // FIX: per-contact timer/queue state instead of one shared `typingTimeout`.
  // Keyed by contact id so sending to one contact can never cancel a
  // reply that is already queued for a different (or the same) contact.
  const contactState = {};
  function getState(id){
    if(!contactState[id]) contactState[id] = { replyQueue: Promise.resolve() };
    return contactState[id];
  }
 
  /* ---------------- Helpers ---------------- */
  function initials(name){
    return name.split(" ").filter(Boolean).slice(0,2).map(w=>w[0]).join("").toUpperCase();
  }
 
  function nowTime(){
    const d = new Date();
    const h = String(d.getHours()).padStart(2,"0");
    const m = String(d.getMinutes()).padStart(2,"0");
    return h+":"+m;
  }
 
  function escapeHtml(str){
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }
 
  function getContact(id){
    return contacts.find(c => c.id === id);
  }
 
  const tickSvg = `<svg class="tick" viewBox="0 0 16 11" fill="none"><path d="M1 5.5L4.5 9L11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 5.5L9 9L15.5 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
 
  /* ---------------- Render sidebar ---------------- */
  function renderContactList(filter){
    const list = document.getElementById("contactList");
    const q = (filter || "").trim().toLowerCase();
    list.innerHTML = "";
 
    contacts
      .filter(c => c.name.toLowerCase().includes(q))
      .forEach(c => {
        const last = c.messages[c.messages.length - 1];
        const item = document.createElement("div");
        item.className = "contact" + (c.id === activeId ? " active" : "");
        item.setAttribute("role","button");
        item.tabIndex = 0;
        item.dataset.id = c.id;
 
        const badge = unread[c.id]
          ? `<span class="unread-badge">${unread[c.id]}</span>` : "";
 
        item.innerHTML = `
          <div class="avatar" style="background:${c.color}">
            ${initials(c.name)}
            ${c.online ? '<span class="status-dot"></span>' : ""}
          </div>
          <div class="contact-info">
            <div class="contact-name-row">
              <span class="contact-name">${escapeHtml(c.name)}</span>
              <span class="contact-time">${last ? last.time : ""}</span>
            </div>
            <div class="contact-preview-row">
              <span class="contact-preview">${last ? escapeHtml(last.text) : ""}</span>
              ${badge}
            </div>
          </div>`;
 
        item.addEventListener("click", () => openChat(c.id));
        item.addEventListener("keydown", (e) => {
          if(e.key === "Enter" || e.key === " "){ e.preventDefault(); openChat(c.id); }
        });
 
        list.appendChild(item);
      });
  }
 
  /* ---------------- Render chat panel ---------------- */
  function renderChatPanel(){
    const panel = document.getElementById("chatPanel");
    const c = getContact(activeId);
 
    if(!c){
      panel.innerHTML = `
        <div class="empty-state">
          <span class="brand-mark">Percakapan</span>
          <p>Pilih salah satu obrolan di sebelah kiri untuk mulai membaca dan membalas pesan.</p>
        </div>`;
      return;
    }
 
    panel.innerHTML = `
      <header class="chat-header">
        <button class="back-btn" id="backBtn" aria-label="Kembali ke daftar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="avatar" style="background:${c.color}">
          ${initials(c.name)}
          ${c.online ? '<span class="status-dot"></span>' : ""}
        </div>
        <div class="chat-header-info">
          <div class="chat-header-name">${escapeHtml(c.name)}</div>
          <div class="chat-header-status" id="statusText">${c.online ? "online" : (c.lastSeen || "")}</div>
        </div>
        <div class="header-actions">
          <button class="icon-btn" title="Cari dalam obrolan" aria-label="Cari dalam obrolan">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3" stroke-linecap="round"/></svg>
          </button>
          <button class="icon-btn" title="Info kontak" aria-label="Info kontak">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><circle cx="12" cy="8" r=".6" fill="currentColor"/></svg>
          </button>
        </div>
      </header>
 
      <div class="messages" id="messages"></div>
 
      <footer class="composer">
        <button class="icon-btn" title="Lampirkan berkas" aria-label="Lampirkan berkas">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.5l-8.5 8.5a4.2 4.2 0 01-6-6l8.2-8.2a2.8 2.8 0 014 4L10.4 19a1.4 1.4 0 01-2-2l7-7"/></svg>
        </button>
        <div class="composer-input-wrap">
          <textarea class="composer-input" id="composerInput" placeholder="Tulis pesan…" rows="1"></textarea>
        </div>
        <button class="send-btn" id="sendBtn" aria-label="Kirim pesan" disabled>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 20l18-8L3 4v6l12 2-12 2v6z"/></svg>
        </button>
      </footer>
    `;
 
    renderMessages();
 
    // wiring
    const backBtn = document.getElementById("backBtn");
    if(backBtn){
      backBtn.addEventListener("click", () => {
        document.getElementById("app").classList.remove("chat-open");
      });
    }
 
    const input = document.getElementById("composerInput");
    const sendBtn = document.getElementById("sendBtn");
 
    function refreshSendState(){
      sendBtn.disabled = input.value.trim().length === 0;
    }
 
    input.addEventListener("input", () => {
      input.style.height = "auto";
      input.style.height = Math.min(input.scrollHeight, 110) + "px";
      refreshSendState();
    });
 
    input.addEventListener("keydown", (e) => {
      if(e.key === "Enter" && !e.shiftKey){
        e.preventDefault();
        trySend();
      }
    });
 
    sendBtn.addEventListener("click", trySend);
 
    function trySend(){
      const val = input.value.trim();
      if(!val) return;
      sendMessage(val);
      input.value = "";
      input.style.height = "auto";
      refreshSendState();
      input.focus();
    }
 
    refreshSendState();
  }
 
  function renderMessages(){
    const c = getContact(activeId);
    const box = document.getElementById("messages");
    if(!box || !c) return;
 
    box.innerHTML = `<div class="day-divider">Hari ini</div>`;
 
    c.messages.forEach(m => {
      const row = document.createElement("div");
      row.className = "bubble-row " + m.from;
      const meta = m.from === "out"
        ? `<div class="bubble-meta"><span>${m.time}</span>${m.read ? tickSvg : ""}</div>`
        : `<div class="bubble-meta"><span>${m.time}</span></div>`;
      row.innerHTML = `<div class="bubble">${escapeHtml(m.text)}${meta}</div>`;
      box.appendChild(row);
    });
 
    box.scrollTop = box.scrollHeight;
  }
 
  function showTyping(){
    const c = getContact(activeId);
    const box = document.getElementById("messages");
    const statusEl = document.getElementById("statusText");
    if(!box || !c) return;
 
    // FIX: remove any stray indicator first so two bubbles never stack.
    const existing = document.getElementById("typingRow");
    if(existing) existing.remove();
 
    if(statusEl) statusEl.textContent = "sedang mengetik…";
    if(statusEl) statusEl.classList.add("typing");
 
    const row = document.createElement("div");
    row.className = "typing-row";
    row.id = "typingRow";
    row.innerHTML = `<div class="typing-bubble"><span></span><span></span><span></span></div>`;
    box.appendChild(row);
    box.scrollTop = box.scrollHeight;
  }
 
  function hideTyping(){
    const row = document.getElementById("typingRow");
    if(row) row.remove();
    const statusEl = document.getElementById("statusText");
    if(statusEl){
      statusEl.classList.remove("typing");
      const c = getContact(activeId);
      if(c) statusEl.textContent = c.online ? "online" : (c.lastSeen || "");
    }
  }
 
  function sendMessage(text){
    const c = getContact(activeId);
    if(!c) return;
 
    c.messages.push({from:"out", text, time: nowTime(), read:false});
    renderMessages();
    renderContactList(document.getElementById("searchInput").value);
 
    const state = getState(c.id);
 
    // Mark the message read shortly after sending. This only touches the
    // data model + re-renders the bubble tick if this chat is still open —
    // it no longer assumes the chat you're viewing is still this contact.
    setTimeout(() => {
      const last = c.messages[c.messages.length - 1];
      if(last) last.read = true;
      if(activeId === c.id) renderMessages();
    }, 500);
 
    // FIX: queue this reply after any reply already pending for the same
    // contact, instead of clearing a shared timer. Every sent message now
    // gets answered — nothing gets silently cancelled by a fast follow-up
    // message, and nothing gets dropped if you switch chats meanwhile.
    state.replyQueue = state.replyQueue.then(() => new Promise((resolve) => {
      if(activeId === c.id) showTyping();
 
      const delay = 1600 + Math.random() * 900;
      setTimeout(() => {
        if(activeId === c.id) hideTyping();
 
        const reply = autoReplies[Math.floor(Math.random() * autoReplies.length)];
        c.messages.push({from:"in", text: reply, time: nowTime()});
 
        if(activeId === c.id){
          renderMessages();
        } else {
          unread[c.id] = (unread[c.id] || 0) + 1;
        }
        renderContactList(document.getElementById("searchInput").value);
        resolve();
      }, delay);
    }));
  }
 
  function openChat(id){
    activeId = id;
    delete unread[id];
    renderContactList(document.getElementById("searchInput").value);
    renderChatPanel();
    document.getElementById("app").classList.add("chat-open");
  }
 
  /* ---------------- Theme ---------------- */
  function initTheme(){
    const root = document.documentElement;
    const btn = document.getElementById("themeToggle");
    let dark = false;
    try {
      dark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
    } catch(e){ /* ignore */ }
    if(dark) root.setAttribute("data-theme","dark");
 
    btn.addEventListener("click", () => {
      const isDark = root.getAttribute("data-theme") === "dark";
      if(isDark){ root.removeAttribute("data-theme"); }
      else{ root.setAttribute("data-theme","dark"); }
    });
  }
 
  /* ---------------- Init ---------------- */
  function init(){
    renderContactList("");
    renderChatPanel();
    initTheme();
 
    document.getElementById("searchInput").addEventListener("input", (e) => {
      renderContactList(e.target.value);
    });
 
    if(window.innerWidth <= 820){
      document.getElementById("app").classList.remove("chat-open");
    }
  }
 
  document.addEventListener("DOMContentLoaded", init);
})();
</script>
</body>
</html>
 

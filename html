      ]
    },
    {
      id: "keluarga-besar",
      name: "Keluarga Besar",
      color: palette[7],
      online: false,
      lastSeen: "terakhir dilihat 07:15",
      messages: [
        {from:"in",  text:"Lebaran tahun ini kumpul di rumah Bude ya", time:"07:10"},
        {from:"in",  text:"Yang mau bawa oleh-oleh boleh, gausah maksa", time:"07:12"},
